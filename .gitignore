# Скомпилированный Python: собирается сам, в репозитории ему не место.
__pycache__/
*.py[cod]
.pytest_cache/

# Рабочие данные: базы посещений и заявок, выгрузка в CSV.
# Появляются при первом запуске сайта и принадлежат конкретной установке.
data/

# Настройки: токены ботов и SECRET_KEY. В config.py лежат заглушки,
# настоящие значения — только в переменных окружения или в .env (а он в git не попадает).
.env

# Логи и временные файлы
*.log
*.sqlite
*.sqlite3
*.db

# Служебное
.vscode/
.idea/
